# Copy to .dev.vars (read by `wrangler pages dev`) and fill in. Never commit real keys.
# In production, set these in Cloudflare → Pages project → Settings → Variables and secrets
# (RAZORPAY_KEY_SECRET as a Secret). The browser gets the Key ID from the server at checkout,
# so no VITE_ variable is needed and the secret never reaches frontend code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: webhook signing secret from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=
SESSION_SECRET=any-long-random-string-for-local-testing
